# Dependencies
node_modules/
*/node_modules/

# Environment variables (never commit these)
backend/.env
frontend/.env

# Secrets / keystores
frontend/android/*.jks
frontend/android/**/*.jks

# Vite temp files
*.timestamp-*.mjs

# Database files (including WAL/SHM journal files)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Build output
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
backend/data/.fuse_hidden*
